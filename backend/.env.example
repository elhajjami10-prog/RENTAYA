# --- Base ---
PORT=4000
DATABASE_URL=postgresql://rentaya:rentaya@localhost:5432/rentaya
JWT_SECRET=change-me-in-production
# URL publique de l'API (utilisée pour les callbacks CMI et les URLs des fichiers)
PUBLIC_API_URL=http://localhost:4000
# URL de l'app web (redirection après paiement)
PUBLIC_APP_URL=http://localhost:8081

# --- CMI (passerelle de paiement des banques marocaines) ---
# Fournis par le CMI à la signature du contrat marchand
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# --- SMS (vérification du téléphone) ---
# Laisser vide en développement : les codes sont affichés dans la console
SMS_PROVIDER=
SMS_API_KEY=

# --- Email (SMTP) ---
SMTP_URL=
MAIL_FROM="Rentaya <no-reply@rentaya.ma>"
